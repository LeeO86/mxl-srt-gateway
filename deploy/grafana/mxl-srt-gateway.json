{
  "title": "MXL SRT Gateway",
  "uid": "mxl-srt-gateway",
  "schemaVersion": 39,
  "timezone": "browser",
  "panels": [
    {"type": "stat", "title": "State", "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}, "targets": [{"expr": "mxl_srt_gateway_channel_state"}]},
    {"type": "timeseries", "title": "SRT RTT", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "targets": [{"expr": "mxl_srt_gateway_srt_rtt_ms"}]},
    {"type": "timeseries", "title": "Bitrate", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "targets": [{"expr": "mxl_srt_gateway_srt_bitrate_bps"}]},
    {"type": "timeseries", "title": "Loss and retransmits", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "targets": [{"expr": "rate(mxl_srt_gateway_srt_pkt_loss_total[1m])"}, {"expr": "rate(mxl_srt_gateway_srt_pkt_retrans_total[1m])"}]},
    {"type": "timeseries", "title": "Frame sync", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "targets": [{"expr": "rate(mxl_srt_gateway_framesync_repeats_total[1m])"}, {"expr": "rate(mxl_srt_gateway_framesync_drops_total[1m])"}]},
    {"type": "timeseries", "title": "Audio FIFO", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 20}, "targets": [{"expr": "mxl_srt_gateway_audio_fifo_ms"}]},
    {"type": "timeseries", "title": "Encode latency", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 20}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(mxl_srt_gateway_encode_latency_seconds_bucket[5m])) by (le, channel))"}]},
    {"type": "stat", "title": "GPU sessions", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20}, "targets": [{"expr": "mxl_srt_gateway_nvdec_sessions"}, {"expr": "mxl_srt_gateway_nvenc_sessions"}]}
  ]
}
